<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- VIDEO: fondo, ocupa toda la pantalla (NO dentro de ScrollView) -->
    <TextureView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Estado de conexión DJI + PC (arriba izquierda) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="#99000000"
        android:padding="8dp"
        android:text="Inicializando..."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Telemetría (abajo izquierda) -->
    <TextView
        android:id="@+id/telemetryText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:background="#99000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Panel de controles (derecha, scrollable) -->
    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#CC000000"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/virtualStickText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#22FFFFFF"
                android:padding="8dp"
                android:text="PRUEBA VIRTUAL STICK&#10;&#10;Esperando..."
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- ===== SEGURIDAD (siempre arriba) ===== -->
            <Button
                android:id="@+id/emergencyStopButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#CC0000"
                android:text="STOP / HOVER"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/landingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FF8F00"
                android:enabled="false"
                android:text="ATERRIZAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- ===== VIRTUAL STICK ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="VIRTUAL STICK"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/enableVirtualStickButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1. ACTIVAR CONTROL" />

            <Button
                android:id="@+id/takeoffButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="2. DESPEGAR → 1 m" />

            <Button
                android:id="@+id/autoTestButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="3. PRUEBA AUTOMÁTICA" />

            <Button
                android:id="@+id/testForwardButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="4. AVANZAR 1 s" />

            <Button
                android:id="@+id/returnButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="5. REGRESAR 1 s" />

            <Button
                android:id="@+id/testOneMeterButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="6. A → 1 m → A" />

            <Button
                android:id="@+id/gpsOutAndBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="7. GPS A → B → A (3 m)" />

            <!-- ===== WAYPOINT MISSION ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="WAYPOINT MISSION (DJI)"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/wpLoadTestButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="WP: CARGAR A→B→A (5 m)" />

            <Button
                android:id="@+id/wpLoadServerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WP: CARGAR RUTA DEL PANEL" />

            <Button
                android:id="@+id/wpUploadButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="WP: SUBIR AL DRON" />

            <Button
                android:id="@+id/wpStartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="WP: INICIAR MISIÓN" />

            <Button
                android:id="@+id/wpStopButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="WP: DETENER MISIÓN" />

            <!-- ===== VIDEO / PC ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="VIDEO Y SERVIDOR"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/recButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="● REC" />

            <!-- Tramos que no llegaron a la PC (sin Wi-Fi / sin recorrido abierto) -->
            <Button
                android:id="@+id/resendButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="SIN TRAMOS PENDIENTES" />

            <Button
                android:id="@+id/serverButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PC: configurar IP" />

            <!-- LOG en pantalla, dentro del panel de controles -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="--- LOG ---"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/errorLogScroll"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="4dp"
                android:background="#33000000"
                android:padding="4dp">

                <TextView
                    android:id="@+id/errorLogText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--- LOG ---"
                    android:textColor="#FFEB3B"
                    android:textSize="10sp" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
